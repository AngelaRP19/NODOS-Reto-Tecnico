DB_HOST=localhost
DB_PORT=5432
DB_NAME=nodos_db
DB_USERNAME=postgres
DB_PASSWORD=your_password

SERVER_PORT=8081

JWT_SECRET=your_secure_jwt_secret_key_min_32_chars

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

META_CLIENT_ID=your_meta_client_id
META_CLIENT_SECRET=your_meta_client_secret
RESEND_API_KEY=your_resend_api_key

# Debe coincidir exactamente con VITE_CRYPTO_SECRET_KEY del frontend
CRYPTO_SECRET_KEY=your_base64_aes_256_key

FRONTEND_URL=http://localhost:5173/
# Opcional: orígenes adicionales para CORS, separados por coma (ej. staging + prod).
# Si no se define, cae en FRONTEND_URL.
CORS_ALLOWED_ORIGINS=
